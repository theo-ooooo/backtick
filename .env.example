# --- database ---
# 로컬: postgresql://backtick:backtick@localhost:5432/backtick
# Supabase: 프로젝트 Connect > URI (마이그레이션은 5432 direct, 런타임은 6543 pooler 권장)
DATABASE_URL=""

# --- auth ---
AUTH_SECRET=""            # openssl rand -base64 32
AUTH_GITHUB_ID=""         # GitHub OAuth App (콜백: {origin}/api/auth/callback/github)
AUTH_GITHUB_SECRET=""
AUTH_TRUST_HOST=true
# ALLOW_DEV_LOGIN=1       # 프로덕션에서 이메일 임시 로그인 허용(테스트용)

# --- ingest cron ---
CRON_SECRET=""            # Vercel Cron 인증용 (Bearer)
